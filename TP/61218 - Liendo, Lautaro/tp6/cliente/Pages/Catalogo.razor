#nullable enable
@page "/"
@inject TiendaService TiendaService

<h2 class="mb-4">Catálogo de Prendas</h2>

@if (prendas == null)
{
    <p>Cargando prendas...</p>
}
else if (!prendas.Any())
{
    <p>No se encontraron prendas.</p>
}
else
{
    <div class="row">
        @foreach (var prenda in prendas)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <img src="@prenda.Imagen" class="card-img-top" alt="@prenda.Titulo">
                    <div class="card-body">
                        <h5 class="card-title">@prenda.Titulo</h5>
                        <p class="card-text">@prenda.Descripcion</p>
                        <p><strong>Precio:</strong> $@prenda.Precio</p>
                        <p><strong>Stock:</strong> @prenda.Inventario unidades</p>

                        <input type="number" class="form-control mb-2" @bind="@cantidades[prenda.PrendaId]" min="1" max="@prenda.Inventario" />

                        <button class="btn btn-primary w-100" @onclick="() => AgregarAlCarrito(prenda.PrendaId)">
                            Agregar al carrito
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PrendaDto>? prendas;
    private Dictionary<int, int> cantidades = new();

    protected override async Task OnInitializedAsync()
    {
        prendas = await TiendaService.ObtenerPrendasAsync();
        foreach (var prenda in prendas)
        {
            cantidades[prenda.PrendaId] = 1;
        }
    }

    private async Task AgregarAlCarrito(int prendaId)
    {
        if (cantidades.TryGetValue(prendaId, out int cantidad) && cantidad > 0)
        {
            await TiendaService.AgregarOActualizarCarritoAsync(prendaId, cantidad);
        }
    }
}
