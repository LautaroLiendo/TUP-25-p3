#nullable enable
@page "/carrito"
@inject TiendaService TiendaService

<h2 class="mb-4">Carrito de Compras</h2>

@if (itemsCarrito == null)
{
    <p>Cargando carrito...</p>
}
else if (!itemsCarrito.Any())
{
    <div class="alert alert-info">Tu carrito está vacío.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Prenda</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in itemsCarrito)
            {
                <tr>
                    <td>@item.NombrePrenda</td>
                    <td>@item.Cantidad</td>
                    <td>$@item.PrecioUnitario</td>
                    <td>$@(item.Cantidad * item.PrecioUnitario)</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarItem(item.PrendaId)">Eliminar</button>
                        <button class="btn btn-sm btn-secondary ms-2" @onclick="() => CambiarCantidad(item.PrendaId, 1)">+1</button>
                        <button class="btn btn-sm btn-secondary ms-1" @onclick="() => CambiarCantidad(item.PrendaId, -1)">-1</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mb-3">
        <strong>Total a pagar:</strong> $@itemsCarrito.Sum(i => i.Cantidad * i.PrecioUnitario)
    </div>

    <a class="btn btn-success" href="/confirmar">Confirmar compra</a>
}

@code {
    private List<ItemCarritoDto>? itemsCarrito;

    protected override async Task OnInitializedAsync()
    {
        await CargarCarrito();
    }

    private async Task CargarCarrito()
    {
        itemsCarrito = await TiendaService.ObtenerItemsCarritoAsync();
    }

    private async Task CambiarCantidad(int prendaId, int delta)
    {
        var item = itemsCarrito?.FirstOrDefault(i => i.PrendaId == prendaId);
        if (item == null) return;

        int nuevaCantidad = item.Cantidad + delta;
        if (nuevaCantidad <= 0)
        {
            await TiendaService.QuitarDelCarritoAsync(prendaId);
        }
        else
        {
            await TiendaService.AgregarOActualizarCarritoAsync(prendaId, nuevaCantidad);
        }

        await CargarCarrito();
    }

    private async Task EliminarItem(int prendaId)
    {
        await TiendaService.QuitarDelCarritoAsync(prendaId);
        await CargarCarrito();
    }
}
